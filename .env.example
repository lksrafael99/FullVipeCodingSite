# Número com DDI e DDD, somente dígitos. Ex.: 5511999999999
NEXT_PUBLIC_PURCHASE_WHATSAPP=

# Checkout padrão (usado por qualquer plano se o específico abaixo não for definido).
# Não existe fallback para links antigos — sem configuração, o botão cai pro WhatsApp.
NEXT_PUBLIC_CHECKOUT_URL=
# Checkout específico por oferta (mesmo produto Kiwify, planos/links diferentes).
NEXT_PUBLIC_CHECKOUT_URL_MONTHLY=
NEXT_PUBLIC_CHECKOUT_URL_ANNUAL=
NEXT_PUBLIC_CHECKOUT_URL_LIFETIME=

# Comunidade geral (free) no WhatsApp. Também tem valor padrão em config/purchase.ts.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=

NEXT_PUBLIC_SITE_URL=https://fullvipecoding.com
